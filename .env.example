# Copy this file to .env (or set these as real environment variables on your
# hosting platform) and fill in real values. NEVER commit the actual .env file.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/testdb
DB_USERNAME=root
DB_PASSWORD=

# --- JPA / Hibernate ---
# Use "validate" or "none" in production once your schema is stable.
# "update" is convenient for local dev but risky against a production DB.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# --- Mail (used for OTP emails) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Misc ---
PORT=8080
THYMELEAF_CACHE=true
